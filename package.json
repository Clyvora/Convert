{
  "name": "clyvora-convert",
  "private": true,
  "version": "0.3.0-beta.1",
  "description": "Public media downloading and private on-device audio/video conversion.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://www.convert.clyvora.tech/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clyvora/Convert.git"
  },
  "bugs": {
    "url": "https://github.com/Clyvora/Convert/issues"
  },
  "keywords": [
    "audio-converter",
    "video-converter",
    "local-first",
    "privacy",
    "webassembly"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/ffmpeg/copy-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ffmpeg/copy-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint --ignore-pattern public/ffmpeg/**",
    "prepreview": "node scripts/ffmpeg/copy-assets.mjs",
    "preview": "vite preview",
    "prepare:ffmpeg": "node scripts/ffmpeg/copy-assets.mjs",
    "pretest": "node scripts/ffmpeg/copy-assets.mjs",
    "test": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:unit": "vitest run src/core src/engines",
    "test:integration": "vitest run src/App.test.tsx",
    "test:media": "vitest run --config vitest.browser.config.ts",
    "test:remote": "node tests/remote-flow.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "torph": "^0.1.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "4.1.12",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "playwright": "1.55.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.4",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.19.0"
}
