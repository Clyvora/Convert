{
  "name": "clyvora-convert",
  "private": true,
  "version": "1.0.0",
  "description": "A private, local-first image, audio, and video converter for the browser.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://www.convert.clyvora.tech/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClyvoraTech/Convert.git"
  },
  "bugs": {
    "url": "https://github.com/ClyvoraTech/Convert/issues"
  },
  "keywords": [
    "image-converter",
    "audio-converter",
    "video-converter",
    "local-first",
    "privacy",
    "webassembly"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/ffmpeg/copy-assets.mjs",
    "dev": "vite",
    "dev:links": "concurrently --kill-others --names site,resolver \"pnpm dev\" \"pnpm --dir proxy dev\"",
    "prebuild": "node scripts/ffmpeg/copy-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint --ignore-pattern public/ffmpeg/**",
    "prepreview": "node scripts/ffmpeg/copy-assets.mjs",
    "preview": "vite preview",
    "prepare:ffmpeg": "node scripts/ffmpeg/copy-assets.mjs",
    "test": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:unit": "vitest run src/core src/engines",
    "test:integration": "vitest run src/App.test.tsx src/engines/image/image.integration.test.ts",
    "test:media": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "playwright": "1.55.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
