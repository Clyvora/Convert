{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clyvora-link-resolver",
  "main": "soundcloud-resolver.mjs",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,https://convert.clyvora.tech,https://www.convert.clyvora.tech"
  },
  "ratelimits": [
    {
      "name": "LINK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
